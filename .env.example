# Public site URL (used for share links and metadata)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Optional Ko-fi support button (never gates results)
NEXT_PUBLIC_KOFI_URL=https://ko-fi.com/yourpage

# Google AdSense (load only after user consent)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=

# Dev-only narrative preview (never enable in public production)
ENABLE_DEV_TOOLS=false
